# Clé secrète pour signer les sessions (générer avec : npx auth secret  ou  openssl rand -base64 32)
AUTH_SECRET=change-moi

# Identifiants OAuth Google (Google Cloud Console > APIs & Services > Credentials)
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Mot de passe de la page /admin
ADMIN_PASSWORD=change-moi-aussi

# Nécessaire hors Vercel (dev local, VPS...)
AUTH_TRUST_HOST=true

# Dossier de la base SQLite (Railway : monter un volume sur /data et mettre DATA_DIR=/data)
# DATA_DIR=/data
